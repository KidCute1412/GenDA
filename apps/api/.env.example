# HOSTED TEMPLATE: enter values privately in Render, not in root local .env.
# Copy Supabase Connect -> Session pooler -> JDBC; percent-encode password URL characters.
SPRING_DATASOURCE_URL=jdbc:postgresql://SESSION_POOLER_HOST:5432/postgres?user=postgres.PROJECT_REF&password=URL_ENCODED_PASSWORD&sslmode=require&connectTimeout=10&socketTimeout=30
CORS_ALLOWED_ORIGINS=https://gen-da-web.lok1412.site
DB_POOL_SIZE=3
OPENAPI_ENABLED=false
PORT=10000
RECAPTCHA_SECRET_KEY=SET_PRIVATELY

# Milestone delivery: backend only. For local Compose, put these values in apps/api/.env.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
