# On Vercel use the actual HTTPS backend URL for both variables.
NEXT_PUBLIC_API_URL=http://localhost:3001
API_INTERNAL_URL=http://localhost:3001
# reCAPTCHA is switched off for now; set to true to require it on login and registration again.
NEXT_PUBLIC_RECAPTCHA_ENABLED=false
# reCAPTCHA v3 (score-based) site key. A v2 checkbox key needs NEXT_PUBLIC_RECAPTCHA_VERSION=v2.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LcsC-ItAAAAABAng4wNaPGuXxxoLm2d4CexkO5k
# Server-only secret paired with the site key; required in production. Dev falls back to Google's test secret.
RECAPTCHA_SECRET_KEY=
# Minimum v3 score accepted by /api/recaptcha/verify (0.0-1.0).
RECAPTCHA_MIN_SCORE=0.5


