{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenAPI definition",
    "version": "v0"
  },
  "paths": {
    "/api/v1/users/me/profile": {
      "get": {
        "tags": [
          "student-profile-controller"
        ],
        "summary": "View the authenticated student's profile",
        "operationId": "get",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/StudentProfileResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ]
      },
      "put": {
        "tags": [
          "student-profile-controller"
        ],
        "summary": "Replace the authenticated student's editable profile information",
        "operationId": "update",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateStudentProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/StudentProfileResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ]
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "auth-controller"
        ],
        "summary": "Register a student or an SME account",
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthUserResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": [
          "auth-controller"
        ],
        "summary": "Rotate the refresh token and issue a fresh access token",
        "operationId": "refresh",
        "parameters": [
          {
            "name": "genda_refresh",
            "in": "cookie",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthUserResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth-controller"
        ],
        "summary": "Revoke the current refresh session and clear auth cookies",
        "operationId": "logout",
        "parameters": [
          {
            "name": "genda_refresh",
            "in": "cookie",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth-controller"
        ],
        "summary": "Sign in and issue HttpOnly access and refresh cookies",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthUserResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/skills": {
      "get": {
        "tags": [
          "skill-controller"
        ],
        "summary": "List the canonical skill catalog",
        "operationId": "list",
        "responses": {
          "200": {
            "description": "Canonical skill catalog",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SkillCatalogItemResponse"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects": {
      "get": {
        "tags": [
          "project-controller"
        ],
        "summary": "Browse published projects",
        "operationId": "browse",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "skill",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "minBudget",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          },
          {
            "name": "maxBudget",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 12,
              "maximum": 100,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Published project page",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectPageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid filter",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{projectId}": {
      "get": {
        "tags": [
          "project-controller"
        ],
        "summary": "Get one published project",
        "operationId": "detail",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Published project detail",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectDetailResponse"
                }
              }
            }
          },
          "404": {
            "description": "Project not found",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "health-controller"
        ],
        "summary": "Application and database readiness",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "auth-controller"
        ],
        "summary": "Return the authenticated user represented by the access cookie",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthUserResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ]
      }
    },
    "/api/v1/auth/csrf": {
      "get": {
        "tags": [
          "auth-controller"
        ],
        "summary": "Issue a CSRF token for cookie-authenticated mutations",
        "operationId": "csrf",
        "parameters": [
          {
            "name": "genda_csrf",
            "in": "cookie",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UpdateStudentProfileRequest": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "maxLength": 180,
            "minLength": 0
          },
          "school": {
            "type": "string",
            "maxLength": 180,
            "minLength": 0
          },
          "major": {
            "type": "string",
            "maxLength": 180,
            "minLength": 0
          },
          "studyYear": {
            "type": "string",
            "enum": [
              "YEAR_1",
              "YEAR_2",
              "YEAR_3",
              "YEAR_4",
              "RECENT_GRADUATE"
            ]
          },
          "skillCodes": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 64,
              "minLength": 0
            },
            "maxItems": 8,
            "minItems": 1
          }
        },
        "required": [
          "displayName",
          "major",
          "school",
          "skillCodes",
          "studyYear"
        ]
      },
      "SkillCatalogItemResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "name"
        ]
      },
      "StudentProfileResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "school": {
            "type": [
              "string",
              "null"
            ]
          },
          "major": {
            "type": [
              "string",
              "null"
            ]
          },
          "studyYear": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "YEAR_1",
              "YEAR_2",
              "YEAR_3",
              "YEAR_4",
              "RECENT_GRADUATE"
            ]
          },
          "skills": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SkillCatalogItemResponse"
            }
          },
          "verificationStatus": {
            "type": "string"
          },
          "complete": {
            "type": "boolean"
          }
        },
        "required": [
          "complete",
          "displayName",
          "email",
          "skills",
          "userId",
          "verificationStatus"
        ]
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 180,
            "minLength": 0
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "minLength": 0
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8
          },
          "role": {
            "type": "string",
            "enum": [
              "STUDENT",
              "SME"
            ]
          },
          "taxCode": {
            "type": "string",
            "maxLength": 32,
            "minLength": 0
          },
          "companyWebsite": {
            "type": "string",
            "maxLength": 512,
            "minLength": 0
          }
        },
        "required": [
          "email",
          "name",
          "password",
          "role"
        ]
      },
      "AuthUserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "STUDENT",
              "SME",
              "ADMIN"
            ]
          },
          "emailVerified": {
            "type": "boolean"
          },
          "studentVerificationStatus": {
            "type": "string"
          },
          "smeApprovalStatus": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "emailVerified",
          "id",
          "name",
          "role"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "minLength": 0
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8
          },
          "rememberDevice": {
            "type": "boolean"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      },
      "ProjectPageResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectSummaryResponse"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "total": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "data",
          "page",
          "pageSize",
          "total"
        ]
      },
      "ProjectSummaryResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "smeName": {
            "type": "string"
          },
          "smeIndustry": {
            "type": "string"
          },
          "budget": {
            "type": "integer",
            "format": "int64"
          },
          "deadline": {
            "type": "string",
            "format": "date"
          },
          "summary": {
            "type": "string"
          },
          "skills": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SkillResponse"
            }
          }
        },
        "required": [
          "budget",
          "deadline",
          "id",
          "skills",
          "smeIndustry",
          "smeName",
          "summary",
          "title"
        ]
      },
      "SkillResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "name"
        ]
      },
      "MilestoneResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "order": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "budget": {
            "type": "integer",
            "format": "int64"
          },
          "deadline": {
            "type": "string",
            "format": "date"
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "budget",
          "criteria",
          "deadline",
          "id",
          "order",
          "title"
        ]
      },
      "ProjectDetailResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "smeName": {
            "type": "string"
          },
          "smeIndustry": {
            "type": "string"
          },
          "smeSize": {
            "type": "string"
          },
          "smeContact": {
            "type": "string"
          },
          "budget": {
            "type": "integer",
            "format": "int64"
          },
          "deadline": {
            "type": "string",
            "format": "date"
          },
          "summary": {
            "type": "string"
          },
          "problem": {
            "type": "string"
          },
          "skills": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SkillResponse"
            }
          },
          "acceptanceCriteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "milestones": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MilestoneResponse"
            }
          }
        },
        "required": [
          "acceptanceCriteria",
          "budget",
          "deadline",
          "id",
          "milestones",
          "problem",
          "skills",
          "smeContact",
          "smeIndustry",
          "smeName",
          "smeSize",
          "summary",
          "title"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "service": {
            "type": "string",
            "enum": [
              "genda-api"
            ]
          }
        },
        "required": [
          "service",
          "status"
        ]
      },
      "CsrfResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        },
        "required": [
          "token"
        ]
      }
    },
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "name": "genda_access",
        "in": "cookie"
      }
    }
  }
}
